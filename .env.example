# Copy to .env.local for local work. NEVER commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase public/browser config (Batch 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret; never expose in browser (Batch 2)
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (Batch 4). Add the keys you want; turn each provider on in Admin -> AI providers.
# Keys live ONLY here (Vercel environment variables). They are never stored in the database.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: max AI generations per user per hour (default 30)
AI_MAX_GENERATIONS_PER_HOUR=
# Optional: reading web pages for posts (Batch 5). Per user per hour, and per website per hour (defaults 20 and 5)
URL_EXTRACTIONS_PER_HOUR=
URL_EXTRACTIONS_PER_HOST_PER_HOUR=
# Optional, preview/development only (ignored in production): 1 = use built-in sample text instead of a real AI
AI_MOCK=

# Meta OAuth / Graph API (Batch 8). Step-by-step: docs/META_SETUP.md
META_APP_ID=
META_APP_SECRET=
# Optional. Default: <your app address>/api/meta/callback  (must match the Meta app exactly)
META_REDIRECT_URI=
# Optional. Default: v25.0
META_GRAPH_API_VERSION=
# Optional. Facebook Login for Business configuration id (see docs/META_SETUP.md, step 6)
META_LOGIN_CONFIG_ID=
# Required for connecting Pages: any random string of 32 or more characters. It encrypts stored Page tokens.
# Keep a copy somewhere safe: if you lose it, Pages must be connected again.
TOKEN_ENCRYPTION_KEY=
# Optional, preview/development only (ignored in production): 1 = pretend Facebook with sample Pages
META_MOCK=

# Resend (Batch 10). Step-by-step: docs/EMAIL_SETUP.md
RESEND_API_KEY=
# Sender on your verified domain, for example: LazyAI <notifications@mail.example.com>
RESEND_FROM_EMAIL=
# Signing secret of the Resend webhook (starts with whsec_); lets LazyAI track delivered, bounced, and spam complaints
RESEND_WEBHOOK_SECRET=

# Scheduler (Batch 9). Step-by-step: docs/SCHEDULER_SETUP.md
# A random string of 16 or more characters. The scheduler must send it as "Authorization: Bearer <value>".
CRON_SECRET=
# Emergency stop only: set to 0 to force real Facebook posting off. The normal on/off switch is in the app: Admin -> Publishing.
LIVE_PUBLISHING_ENABLED=

# Legal pages (public, not secret): who runs the service and how to reach you
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OPERATOR_COUNTRY=
JOB_WORKER_BATCH_SIZE=

# Optional stock photo search (Batch 7). Set IMAGE_PROVIDER=pexels and paste a free Pexels API key.
# Leave both empty to keep stock search off (uploading your own images always works).
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=

# Optional error monitoring
ERROR_TRACKING_DSN=
