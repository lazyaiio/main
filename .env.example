# Copy to .env.local for local work. NEVER commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase public/browser config (Batch 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret; never expose in browser (Batch 2)
SUPABASE_SERVICE_ROLE_KEY=

# AI provider (Batch 4)
AI_PROVIDER=
AI_API_KEY=
AI_TEXT_MODEL=

# Meta OAuth / Graph API (Batch 8)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=

# Resend (Batch 10)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Scheduler (Batch 9)
CRON_SECRET=
JOB_WORKER_BATCH_SIZE=

# Optional image provider (Batch 7)
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=

# Optional error monitoring
ERROR_TRACKING_DSN=
